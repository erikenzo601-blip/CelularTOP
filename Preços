  <script>

    /* ==========================================
       PRODUTOS
       ========================================== */

    /*
      Estes preços são exemplos.
      Para preços realmente atualizados,
      posteriormente podemos substituir
      esta estrutura por uma API.
    */

    const produtos = [

      /* CELULARES */

      {
        id: 1,
        nome: "Galaxy A15",
        categoria: "celular",
        marca: "Samsung",
        preco: 899,
        desempenho: 72,
        camera: 78,
        bateria: 90
      },

      {
        id: 2,
        nome: "Galaxy A25",
        categoria: "celular",
        marca: "Samsung",
        preco: 1299,
        desempenho: 82,
        camera: 82,
        bateria: 88
      },

      {
        id: 3,
        nome: "Redmi Note 13",
        categoria: "celular",
        marca: "Xiaomi",
        preco: 1099,
        desempenho: 84,
        camera: 80,
        bateria: 87
      },

      {
        id: 4,
        nome: "Moto G54",
        categoria: "celular",
        marca: "Motorola",
        preco: 999,
        desempenho: 86,
        camera: 76,
        bateria: 91
      },

      {
        id: 5,
        nome: "Redmi Note 13 Pro",
        categoria: "celular",
        marca: "Xiaomi",
        preco: 1699,
        desempenho: 91,
        camera: 92,
        bateria: 88
      },


      /* PCS */

      {
        id: 101,
        nome: "PC Gamer Básico",
        categoria: "pc",
        marca: "Intel",
        preco: 1479,
        desempenho: 70
      },

      {
        id: 102,
        nome: "PC Gamer Ryzen 5",
        categoria: "pc",
        marca: "AMD",
        preco: 2299,
        desempenho: 86
      },

      {
        id: 103,
        nome: "PC Gamer Intermediário",
        categoria: "pc",
        marca: "AMD",
        preco: 2999,
        desempenho: 92
      }

    ];


    /* ==========================================
       ESTADO
       ========================================== */

    let categoriaAtual =
      "celular";

    let produtosFiltrados =
      [];


    /* ==========================================
       PREÇO
       ========================================== */

    function formatarPreco(preco) {

      return new Intl.NumberFormat(
        "pt-BR",
        {
          style: "currency",
          currency: "BRL"
        }
      ).format(preco);

    }


    /* ==========================================
       NOTA
       ========================================== */

    function calcularNota(produto) {

      if (
        produto.categoria ===
        "celular"
      ) {

        return Math.round(
          (
            produto.desempenho +
            produto.camera +
            produto.bateria
          ) / 3
        );

      }

      return produto.desempenho;

    }


    /* ==========================================
       PRODUTOS DA CATEGORIA
       ========================================== */

    function produtosDaCategoria() {

      return produtos.filter(
        produto =>
          produto.categoria ===
          categoriaAtual
      );

    }


    /* ==========================================
       MOSTRAR PRODUTOS
       ========================================== */

    function mostrarProdutos(lista) {

      const container =
        document.getElementById(
          categoriaAtual === "celular"
            ? "listaCelulares"
            : "listaPCs"
        );


      if (!container) return;


      container.innerHTML = "";


      if (lista.length === 0) {

        container.innerHTML = `
          <div class="produto">

            <h3>
              Nenhum produto encontrado
            </h3>

            <p>
              Tente alterar a pesquisa
              ou os filtros.
            </p>

          </div>
        `;

        return;

      }


      lista.forEach(
        (produto, index) => {

          const card =
            document.createElement(
              "article"
            );


          card.className =
            "produto";


          const nota =
            calcularNota(produto);


          const icone =
            produto.categoria ===
            "celular"
              ? "📱"
              : "💻";


          card.innerHTML = `

            <div
              class="produto-imagem"
              aria-hidden="true"
            >
              ${icone}
            </div>


            <div class="ranking">
              🏆 Ranking #${index + 1}
            </div>


            <h3>
              ${produto.nome}
            </h3>


            <p>
              Marca:
              <strong>
                ${produto.marca}
              </strong>
            </p>


            <div class="preco">
              ${formatarPreco(
                produto.preco
              )}
            </div>


            <div class="nota">
              ${nota}/100
            </div>


            <p>
              ⚡ Desempenho:
              ${produto.desempenho}/100

              ${
                produto.categoria ===
                "celular"
                  ? `
                    <br>
                    📸 Câmera:
                    ${produto.camera}/100

                    <br>

                    🔋 Bateria:
                    ${produto.bateria}/100
                  `
                  : ""
              }
            </p>


            <button
              type="button"
              class="botao-detalhes"
              onclick="verDetalhes(${produto.id})"
              aria-label="Ver detalhes de ${produto.nome}"
            >
              Ver detalhes
            </button>

          `;


          container.appendChild(card);

        }
      );


      anunciarResultados(lista);

    }


    /* ==========================================
       ANÚNCIO PARA LEITOR DE TELA
       ========================================== */

    function anunciarResultados(lista) {

      let status =
        document.getElementById(
          "statusAcessibilidade"
        );


      if (!status) {

        status =
          document.createElement(
            "div"
          );

        status.id =
          "statusAcessibilidade";

        status.className =
          "sr-only";

        status.setAttribute(
          "aria-live",
          "polite"
        );

        document.body.appendChild(
          status
        );

      }


      status.textContent =
        `${lista.length} ${
          lista.length === 1
            ? "produto encontrado"
            : "produtos encontrados"
        }.`;

    }


    /* ==========================================
       FILTROS
       ========================================== */

    function aplicarFiltros() {

      const pesquisa =
        document.getElementById(
          "pesquisaProduto"
        )?.value
        .toLowerCase()
        .trim() || "";


      const marca =
        document.getElementById(
          "filtroMarca"
        )?.value ||
        "todas";


      const precoMin =
        Number(
          document.getElementById(
            "precoMin"
          )?.value
        ) || 0;


      const precoMaxValor =
        document.getElementById(
          "precoMax"
        )?.value;


      const precoMax =
        precoMaxValor === ""
          ? Infinity
          : Number(
              precoMaxValor
            );


      const desempenhoMin =
        Number(
          document.getElementById(
            "desempenhoMin"
          )?.value
        ) || 0;


      produtosFiltrados =
        produtosDaCategoria()
        .filter(produto => {

          const nomeOK =
            produto.nome
              .toLowerCase()
              .includes(
                pesquisa
              );


          const marcaOK =
            marca === "todas" ||
            produto.marca === marca;


          const precoOK =
            produto.preco >=
              precoMin &&
            produto.preco <=
              precoMax;


          const desempenhoOK =
            produto.desempenho >=
            desempenhoMin;


          return (
            nomeOK &&
            marcaOK &&
            precoOK &&
            desempenhoOK
          );

        });


      ordenarProdutos(false);

    }


    /* ==========================================
       ORDENAÇÃO
       ========================================== */

    function ordenarProdutos(
      atualizar = true
    ) {

      const ordenacao =
        document.getElementById(
          "ordenacao"
        )?.value ||
        "maior-nota";


      if (
        ordenacao ===
        "menor-preco"
      ) {

        produtosFiltrados.sort(
          (a, b) =>
            a.preco -
            b.preco
        );

      }


      else if (
        ordenacao ===
        "maior-preco"
      ) {

        produtosFiltrados.sort(
          (a, b) =>
            b.preco -
            a.preco
        );

      }


      else if (
        ordenacao ===
        "maior-desempenho"
      ) {

        produtosFiltrados.sort(
          (a, b) =>
            b.desempenho -
            a.desempenho
        );

      }


      else {

        produtosFiltrados.sort(
          (a, b) =>
            calcularNota(b) -
            calcularNota(a)
        );

      }


      mostrarProdutos(
        produtosFiltrados
      );

    }


    /* ==========================================
       CRIAR MARCAS
       ========================================== */

    function criarMarcas() {

      const select =
        document.getElementById(
          "filtroMarca"
        );


      if (!select) return;


      const marcas = [
        ...new Set(
          produtosDaCategoria()
            .map(
              produto =>
                produto.marca
            )
        )
      ];


      select.innerHTML = `

        <option value="todas">
          Todas as marcas
        </option>

        ${marcas.map(
          marca =>
            `
            <option
              value="${marca}"
            >
              ${marca}
            </option>
            `
        ).join("")}

      `;

    }


    /* ==========================================
       ATUALIZAÇÃO
       ========================================== */

    function mostrarAtualizacao() {

      const elemento =
        document.getElementById(
          "ultimaAtualizacao"
        );


      if (!elemento) return;


      const agora =
        new Date();


      elemento.textContent =
        `Dados demonstrativos —
        atualização:
        ${agora.toLocaleDateString(
          "pt-BR"
        )}`;

    }


    /* ==========================================
       TROCAR CATEGORIA
       ========================================== */

    function trocarCategoria(
      categoria
    ) {

      categoriaAtual =
        categoria;


      document
        .getElementById(
          "inicio"
        )
        .style.display =
        "none";


      document
        .getElementById(
          "celulares"
        )
        .classList
        .remove("ativo");


      document
        .getElementById(
          "pcs"
        )
        .classList
        .remove("ativo");


      const secao =
        document.getElementById(
          categoria ===
          "celular"
            ? "celulares"
            : "pcs"
        );


      secao
        .classList
        .add("ativo");


      criarMarcas();


      limparFiltros();


      produtosFiltrados =
        produtosDaCategoria();


      mostrarProdutos(
        produtosFiltrados
      );


      mostrarAtualizacao();


      window.scrollTo({
        top: 0,
        behavior: "smooth"
      });

    }


    /* ==========================================
       LIMPAR
       ========================================== */

    function limparFiltros() {

      const ids = [

        "pesquisaProduto",

        "precoMin",

        "precoMax",

        "desempenhoMin"

      ];


      ids.forEach(id => {

        const elemento =
          document.getElementById(
            id
          );


        if (elemento) {
          elemento.value = "";
        }

      });


      const marca =
        document.getElementById(
          "filtroMarca"
        );


      if (marca) {
        marca.value =
          "todas";
      }


      const ordenacao =
        document.getElementById(
          "ordenacao"
        );


      if (ordenacao) {
        ordenacao.value =
          "maior-nota";
      }

    }


    /* ==========================================
       INÍCIO
       ========================================== */

    function mostrarInicio() {

      document
        .getElementById(
          "inicio"
        )
        .style.display =
        "block";


      document
        .getElementById(
          "celulares"
        )
        .classList
        .remove("ativo");


      document
        .getElementById(
          "pcs"
        )
        .classList
        .remove("ativo");


      window.scrollTo({
        top: 0,
        behavior: "smooth"
      });

    }


    /* ==========================================
       DETALHES
       ========================================== */

    function verDetalhes(id) {

      const produto =
        produtos.find(
          produto =>
            produto.id === id
        );


      if (!produto) return;


      const nota =
        calcularNota(
          produto
        );


      alert(
        `${produto.nome}\n\n` +

        `Marca: ${
          produto.marca
        }\n` +

        `Preço: ${
          formatarPreco(
            produto.preco
          )
        }\n` +

        `Desempenho: ${
          produto.desempenho
        }/100\n` +

        `Nota: ${
          nota
        }/100`
      );

    }


    /* ==========================================
       EVENTOS
       ========================================== */

    document.addEventListener(
      "DOMContentLoaded",
      () => {

        criarMarcas();

        mostrarAtualizacao();

        produtosFiltrados =
          produtosDaCategoria();


        document
          .getElementById(
            "pesquisaProduto"
          )
          .addEventListener(
            "input",
            aplicarFiltros
          );


        document
          .getElementById(
            "filtroMarca"
          )
          .addEventListener(
            "change",
            aplicarFiltros
          );


        document
          .getElementById(
            "precoMin"
          )
          .addEventListener(
            "input",
            aplicarFiltros
          );


        document
          .getElementById(
            "precoMax"
          )
          .addEventListener(
            "input",
            aplicarFiltros
          );


        document
          .getElementById(
            "desempenhoMin"
          )
          .addEventListener(
            "input",
            aplicarFiltros
          );


        document
          .getElementById(
            "ordenacao"
          )
          .addEventListener(
            "change",
            () =>
              ordenarProdutos()
          );


        document
          .getElementById(
            "limparFiltros"
          )
          .addEventListener(
            "click",
            () => {

              limparFiltros();

              produtosFiltrados =
                produtosDaCategoria();

              mostrarProdutos(
                produtosFiltrados
              );

            }
          );

      }
    );

  </script>


</body>
</html>
