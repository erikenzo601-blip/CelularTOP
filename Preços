      margin-bottom: 8px;
    }


    .titulo-secao p {
      color: #c2c9d6;
    }


    /* ==========================================
       FILTROS
       ========================================== */

    .filtros {
      width: 100%;

      display: grid;

      grid-template-columns:
        repeat(
          auto-fit,
          minmax(180px, 1fr)
        );

      gap: 12px;

      margin:
        20px 0
        30px;
    }


    .filtros input,
    .filtros select,
    .filtros button {

      width: 100%;

      min-height: 48px;

      padding:
        10px 14px;

      border-radius: 10px;

      border: 1px solid #344158;

      background: #111827;

      color: #ffffff;

      outline: none;
    }


    .filtros input::placeholder {
      color: #aeb7c7;
    }


    .filtros button {
