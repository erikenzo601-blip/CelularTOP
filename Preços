      margin-bottom: 10px;
    }


    .categoria p {
      color: #c2c9d6;

      margin-bottom: 25px;
    }


    .botao {
      display: inline-flex;

      align-items: center;

      justify-content: center;

      min-height: 46px;

      padding:
        10px 24px;

      border-radius: 10px;

      background: #4f8cff;

      color: #ffffff;

      font-weight: bold;
    }


    /* ==========================================
       CONTEÚDO
       ========================================== */

