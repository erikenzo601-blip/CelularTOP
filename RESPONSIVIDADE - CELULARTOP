/* ==========================================
   RESPONSIVIDADE — CELULARTOP
   ========================================== */


/* ------------------------------------------
   BASE DOS CARDS
   ------------------------------------------ */

.produtos {
  display: grid;

  /*
    O navegador calcula automaticamente
    quantos cards cabem na tela.
  */
  grid-template-columns:
    repeat(auto-fit, minmax(240px, 1fr));

  gap: 20px;

  width: 100%;
}


/* ------------------------------------------
   HEADER
   ------------------------------------------ */

header {
  width: 100%;
  min-height: 70px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;
}


/* ------------------------------------------
   MENU
   ------------------------------------------ */

nav {
  display: flex;
  align-items: center;
  gap: 20px;
}

nav a {
  white-space: nowrap;
}


/* ------------------------------------------
   FILTROS
   ------------------------------------------ */

.filtros {
  width: 100%;

  display: grid;

  grid-template-columns:
    repeat(auto-fit, minmax(180px, 1fr));

  gap: 12px;

  margin: 25px 0;
}

.filtros input,
.filtros select,
.filtros button {
  width: 100%;

  min-height: 46px;

  padding: 10px 14px;

  border-radius: 10px;

  border: 1px solid #273244;

  background: #111827;

  color: white;

  font-size: 15px;

  outline: none;
}

.filtros input:focus,
.filtros select:focus {
  border-color: #4f8cff;
}


/* ------------------------------------------
   CELULAR
   Até 600px
   ------------------------------------------ */

@media (max-width: 600px) {

  body {
    overflow-x: hidden;
  }


  /* HEADER */

  header {
    padding: 15px 20px;

    flex-direction: column;

    align-items: center;

    text-align: center;
  }


  /* LOGO */

  .logo {
    font-size: 23px;
  }


  /* MENU */

  nav {
    width: 100%;

    justify-content: center;

    flex-wrap: wrap;

    gap: 10px;
  }

  nav a {
    margin: 0;

    padding: 8px 12px;

    font-size: 14px;
  }


  /* HERO */

  .hero {
    padding:
      45px 18px
      30px;
  }

  .hero h1 {
    font-size: 30px;

    line-height: 1.2;
  }

  .hero p {
    font-size: 15px;

    line-height: 1.6;
  }


  /* CATEGORIAS */

  .categorias {
    width: 100%;

    margin: 15px auto 45px;

    padding: 15px;

    grid-template-columns: 1fr;

    gap: 15px;
  }


  .categoria {
    padding: 30px 20px;
  }


  .categoria .icone {
    font-size: 48px;
  }


  .categoria h2 {
    font-size: 23px;
  }


  /* SEÇÕES */

  .section,
  .conteudo {
    padding:
      25px 15px
      50px;
  }


  /* TÍTULO */

  .titulo-secao h2 {
    font-size: 25px;

    line-height: 1.3;
  }


  .titulo-secao p {
    font-size: 14px;

    line-height: 1.6;
  }


  /* CARDS
     CELULAR = 1 COLUNA
  */

  .produtos {
    grid-template-columns: 1fr;

    gap: 15px;
  }


  .produto {
    width: 100%;

    padding: 17px;
  }


  .produto-imagem {
    height: 170px;
  }


  /* FILTROS */

  .filtros {
    grid-template-columns: 1fr;

    gap: 10px;

    margin: 20px 0;
  }


  .filtros input,
  .filtros select,
  .filtros button {
    min-height: 48px;

    font-size: 16px;
  }


  /* BOTÕES */

  .botao,
  .botao-detalhes,
  .voltar {
    width: 100%;

    text-align: center;

    min-height: 46px;

    display: flex;

    align-items: center;

    justify-content: center;
  }


  /* FOOTER */

  footer {
    padding: 25px 15px;

    font-size: 13px;
  }

}


/* ------------------------------------------
   TABLET
   601px — 900px
   ------------------------------------------ */

@media (min-width: 601px) and (max-width: 900px) {

  header {
    padding:
      18px 30px;
  }


  .hero {
    padding:
      55px 30px
      40px;
  }


  .hero h1 {
    font-size: 36px;
  }


  .categorias {
    grid-template-columns:
      repeat(2, 1fr);

    padding:
      20px 30px;
  }


  /*
    TABLET = 2 COLUNAS
  */

  .produtos {
    grid-template-columns:
      repeat(2, 1fr);

    gap: 18px;
  }


  .section,
  .conteudo {
    padding:
      30px;
  }


  /*
    Filtros podem ficar
    em duas colunas.
  */

  .filtros {
    grid-template-columns:
      repeat(2, 1fr);
  }

}


/* ------------------------------------------
   PC
   901px — 1400px
   ------------------------------------------ */

@media (min-width: 901px) and (max-width: 1400px) {

  /*
    PC = 3 COLUNAS
  */

  .produtos {
    grid-template-columns:
      repeat(3, 1fr);

    gap: 20px;
  }


  .filtros {
    grid-template-columns:
      repeat(3, 1fr);
  }


  .hero h1 {
    font-size: 42px;
  }

}


/* ------------------------------------------
   TELAS GRANDES
   Acima de 1400px
   ------------------------------------------ */

@media (min-width: 1401px) {

  /*
    4 OU MAIS COLUNAS
  */

  .produtos {
    grid-template-columns:
      repeat(auto-fit, minmax(250px, 1fr));

    gap: 24px;
  }


  .filtros {
    grid-template-columns:
      repeat(4, 1fr);
  }


  .section,
  .conteudo {
    padding-left: 6%;
    padding-right: 6%;
  }

}


/* ------------------------------------------
   TELAS MUITO PEQUENAS
   ------------------------------------------ */

@media (max-width: 380px) {

  .hero h1 {
    font-size: 27px;
  }


  .categoria {
    padding: 25px 15px;
  }


  .produto {
    padding: 14px;
  }


  .produto-imagem {
    height: 145px;
  }


  .produto h3 {
    font-size: 18px;
  }

}
