/* ==========================================
   ♿ ACESSIBILIDADE — CELULARTOP
   ========================================== */

/* ------------------------------------------
   CONTRASTE E LEGIBILIDADE
   ------------------------------------------ */

body {
  background: #080b12;
  color: #ffffff;
  font-size: 16px;
  line-height: 1.6;
}

p {
  line-height: 1.7;
}

a {
  color: #8db7ff;
}


/* ------------------------------------------
   FOCO DO TECLADO
   ------------------------------------------ */

:focus {
  outline: 3px solid #ffd54a;
  outline-offset: 3px;
}


/* Evita remover o foco quando
   a pessoa navega pelo teclado */

button:focus-visible,
a:focus-visible,
input:focus-visible,
select:focus-visible {
  outline: 3px solid #ffd54a;
  outline-offset: 3px;
}


/* ------------------------------------------
   BOTÕES
   ------------------------------------------ */

button,
.botao,
.botao-detalhes,
.voltar {
  min-height: 44px;
  cursor: pointer;
}


/* ------------------------------------------
   CAMPOS DE FORMULÁRIO
   ------------------------------------------ */

input,
select,
button {
  font: inherit;
}


/* ------------------------------------------
   NÃO DEPENDER SOMENTE DE COR
   ------------------------------------------ */

/*
   Além da cor, usamos símbolos e texto
   para indicar informações.
*/

.nota {
  font-weight: bold;
}

.nota::before {
  content: "⭐ Nota: ";
}


/* ------------------------------------------
   RANKING
   ------------------------------------------ */

.ranking {
  font-weight: bold;
  margin-bottom: 8px;
}


/* ------------------------------------------
   LINKS
   ------------------------------------------ */

nav a {
  text-decoration: underline;
  text-underline-offset: 4px;
}


/* ------------------------------------------
   TEXTO VISUALMENTE ESCONDIDO
   MAS DISPONÍVEL PARA LEITORES DE TELA
   ------------------------------------------ */

.sr-only {
  position: absolute;

  width: 1px;
  height: 1px;

  padding: 0;
  margin: -1px;

  overflow: hidden;

  clip: rect(0, 0, 0, 0);

  white-space: nowrap;

  border: 0;
}


/* ------------------------------------------
   REDUZIR ANIMAÇÕES
   PARA QUEM PREFERE MENOS MOVIMENTO
   ------------------------------------------ */

@media (prefers-reduced-motion: reduce) {

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }

}


/* ------------------------------------------
   AUMENTAR ESPAÇAMENTO EM TELAS PEQUENAS
   ------------------------------------------ */

@media (max-width: 600px) {

  body {
    font-size: 17px;
  }

  button,
  .botao,
  .botao-detalhes,
  .voltar {
    min-height: 48px;
  }

